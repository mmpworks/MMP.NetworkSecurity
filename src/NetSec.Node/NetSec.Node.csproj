<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin main for the lab's bridge processes. The logic lives in NetSec.Core/Bridge. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetSec.Node</AssemblyName>
    <RootNamespace>NetSec.Node</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetSec.Core\NetSec.Core.csproj" />
  </ItemGroup>

</Project>
