<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetSec.Host</AssemblyName>
    <RootNamespace>NetSec.Host</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetSec.Core\NetSec.Core.csproj" />
  </ItemGroup>

  <!-- Lesson 11 loads this DLL by name. Without it the lesson ends in NATIVE_LIB_MISSING. native\build.cmd makes it. -->
  <ItemGroup>
    <None Include="..\..\native\bin\x64\netsec_ct.dll" Condition="Exists('..\..\native\bin\x64\netsec_ct.dll')" Link="netsec_ct.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
