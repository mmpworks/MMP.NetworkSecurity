<Project Sdk="Microsoft.NET.Sdk">

  <!-- The CLR 2.0 block bench as a 64-bit process. It shares every item with bench/Clr2 (the x86 host) through Clr2.props, and has its own folder so its obj/ is its own. -->

  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <Import Project="..\Clr2\Clr2.props" />

</Project>
