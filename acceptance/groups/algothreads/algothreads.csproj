<Project Sdk="Microsoft.NET.Sdk">
  <!-- AO-4 of docs/algorithm-optimization-prd.md: its own process, because the ThreadPool cap of 25 holds for the whole process (3.1 rule 12).
       It shares the sides, the case helpers and the frozen reference with the algo group. -->
  <Import Project="..\Group.props" />
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <AssemblyName>Acceptance.AlgoThreads</AssemblyName>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\algo\AoSide.cs;..\algo\AoSide.Product.cs;..\algo\AoCases.cs;..\algo\AoGrammar.cs" Link="algo\%(Filename)%(Extension)" />
    <Compile Include="..\algo\Frozen\*.cs" Link="algo\Frozen\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
