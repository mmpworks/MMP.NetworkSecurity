# Downloaded sources and build output stay out of git. CF binaries and CF references never get committed (A9).
vectors/_cache/
**/bin/
**/obj/
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
.work/
# Python bytecode from running acceptance/tools/*.py; it would trip the report's uncommitted-files warning (Jared on #334).
__pycache__/
