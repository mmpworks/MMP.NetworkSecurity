{
  "name": "netsec-app",
  "private": true,
  "version": "0.1.0",
  "description": "Electron front end for MMP.NetworkSecurity",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vue-tsc --noEmit && vite build && node scripts/dist-stamp.cjs write",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit && tsc -p e2e/tsconfig.json",
    "e2e": "npm run build && python -I ../tools/heavy_lock.py run --label \"app e2e\" -- node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mdi/font": "^7.4.47",
    "splitpanes": "^4.1.2",
    "vue": "3.5.13",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "5.2.1",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vue-tsc": "2.2.0",
    "wait-on": "8.0.1"
  }
}
